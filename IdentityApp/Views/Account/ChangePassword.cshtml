@model IdentityApp.Models.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-header bg-dark text-white">
                <h5 class="mb-0">Change Password</h5>
            </div>
            <div class="card-body">
                <p class="text-muted small mb-3">
                    You must know your <strong>current password</strong> to change it.
                    If you have forgotten it, <a asp-action="ForgotPassword">reset it instead</a>.
                </p>

                <form asp-action="ChangePassword" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="mb-3">
                        <label asp-for="CurrentPassword" class="form-label fw-semibold"></label>
                        <input asp-for="CurrentPassword" class="form-control" autofocus />
                        <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                    </div>

                    <hr />

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label fw-semibold"></label>
                        <input asp-for="NewPassword" class="form-control" placeholder="Min 6 chars, include a digit" />
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                        <input asp-for="ConfirmPassword" class="form-control" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-dark flex-grow-1">Change Password</button>
                        <a asp-action="Profile" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>

        <div class="card border-0 shadow-sm mt-4">
            <div class="card-header bg-light"><strong>What happens internally</strong></div>
            <div class="card-body small">
                <ol class="mb-0">
                    <li><code>ChangePasswordAsync(user, currentPwd, newPwd)</code> — verifies current password first</li>
                    <li>Hashes the new password using <strong>PBKDF2</strong></li>
                    <li>Updates <code>SecurityStamp</code> — invalidates all other sessions on other devices</li>
                    <li><code>RefreshSignInAsync(user)</code> — re-issues the cookie so current session stays alive</li>
                </ol>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
