@model IdentityApp.Models.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "My Profile";
}

<div class="row">
    <div class="col-md-4">
        <div class="card shadow-sm mb-4">
            <div class="card-body text-center py-4">
                <div class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center mb-3"
                     style="width:80px;height:80px;font-size:2rem;">
                    @(Model.FirstName.Length > 0 ? Model.FirstName[0].ToString().ToUpper() : "?")
                </div>
                <h5 class="mb-0">@Model.FirstName @Model.LastName</h5>
                <p class="text-muted small">@Model.Email</p>
                <span class="badge bg-secondary">Member since @Model.CreatedAt.ToString("MMM yyyy")</span>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header">
                <h5 class="mb-0">Edit Profile</h5>
            </div>
            <div class="card-body">
                <form asp-action="Profile" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="FirstName" class="form-label fw-semibold"></label>
                            <input asp-for="FirstName" class="form-control" />
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="LastName" class="form-label fw-semibold"></label>
                            <input asp-for="LastName" class="form-control" />
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PhoneNumber" class="form-label fw-semibold"></label>
                        <input asp-for="PhoneNumber" class="form-control" placeholder="+1 555 000 0000" />
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ProfileBio" class="form-label fw-semibold"></label>
                        <textarea asp-for="ProfileBio" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Department" class="form-label fw-semibold">
                                Department
                                <span class="badge bg-info text-dark ms-1" style="font-size:0.7rem;">Claim</span>
                            </label>
                            <select asp-for="Department" class="form-select">
                                <option value="">-- None --</option>
                                <option>Engineering</option>
                                <option>Marketing</option>
                                <option>Finance</option>
                                <option>HR</option>
                            </select>
                            <div class="form-text">Saved as a Claim in AspNetUserClaims</div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Country" class="form-label fw-semibold">
                                Country
                                <span class="badge bg-info text-dark ms-1" style="font-size:0.7rem;">Claim</span>
                            </label>
                            <select asp-for="Country" class="form-select">
                                <option value="">-- None --</option>
                                <option>India</option>
                                <option>USA</option>
                                <option>UK</option>
                                <option>Canada</option>
                            </select>
                            <div class="form-text">Saved as a Claim in AspNetUserClaims</div>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary">Save Changes</button>
                    <a asp-controller="Home" asp-action="Dashboard" class="btn btn-outline-secondary">Cancel</a>
                </form>
            </div>
            <div class="card-footer">
                <a asp-action="ChangePassword" class="btn btn-outline-dark btn-sm">
                    Change Password
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
