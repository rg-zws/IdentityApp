@{
    ViewData["Title"] = "Reset Link Sent";
    var resetLink = TempData["ResetLink"] as string;
}

<div class="row justify-content-center">
    <div class="col-md-7">

        <div class="card shadow-sm border-success">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0">Reset Link Generated</h5>
            </div>
            <div class="card-body">
                <p>
                    If an account with that email exists, a password reset link has been generated.
                    In a real application this link would be <strong>sent to your email</strong>.
                </p>

                @if (resetLink != null)
                {
                    <div class="alert alert-info">
                        <strong>Learning Mode — Reset Link (shown here instead of email):</strong>
                        <div class="mt-2">
                            <a href="@resetLink" class="btn btn-primary btn-sm">Click to Reset Password</a>
                        </div>
                        <hr />
                        <small class="text-break font-monospace">@resetLink</small>
                    </div>

                    <div class="card bg-light border-0 mt-3">
                        <div class="card-body small">
                            <strong>In production you would:</strong>
                            <ol class="mb-0 mt-1">
                                <li>Install an email package (e.g. <code>SendGrid</code>, <code>MailKit</code>)</li>
                                <li>Send the above link to <code>user.Email</code></li>
                                <li>Remove the link from this page entirely</li>
                            </ol>
                        </div>
                    </div>
                }
                else
                {
                    <p class="text-muted">
                        Check your inbox for the reset email. The link expires after a short time.
                    </p>
                }
            </div>
            <div class="card-footer text-center">
                <a asp-action="Login" class="btn btn-outline-secondary btn-sm">Back to Login</a>
            </div>
        </div>

        <div class="card border-0 shadow-sm mt-4">
            <div class="card-header bg-light"><strong>How the reset token works</strong></div>
            <div class="card-body small">
                <ol class="mb-0">
                    <li><code>GeneratePasswordResetTokenAsync(user)</code> — Identity creates a <strong>secure one-time token</strong> tied to the user's current password hash &amp; security stamp</li>
                    <li>Token is embedded in the link as a URL parameter</li>
                    <li>User clicks the link → <code>ResetPasswordAsync(user, token, newPassword)</code> verifies the token and sets the new password</li>
                    <li>Token becomes <strong>invalid after use</strong> and also if the user logs in or changes email</li>
                </ol>
            </div>
        </div>

    </div>
</div>
