@{
    ViewData["Title"] = "JWT + Refresh Token Demo";
}

<h2 class="mb-1">JWT + Refresh Token Demo</h2>
<p class="text-muted mb-4">See Access Token + Refresh Token flow live.</p>

<div class="row g-3">
    <!-- Left: controls -->
    <div class="col-md-4">
        <div class="card shadow-sm mb-3">
            <div class="card-header bg-success text-white"><strong>Step 1 — Login</strong></div>
            <div class="card-body">
                <div class="mb-2">
                    <label class="form-label small fw-semibold">Email</label>
                    <input id="email" class="form-control form-control-sm" value="admin@identityapp.com" />
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-semibold">Password</label>
                    <input id="password" type="password" class="form-control form-control-sm" value="Admin@123" />
                </div>
                <button class="btn btn-success w-100 btn-sm" onclick="loginJwt()">
                    POST /api/authapi/login
                </button>
            </div>
        </div>

        <div class="card shadow-sm mb-3">
            <div class="card-header bg-primary text-white"><strong>Step 2 — Call API</strong></div>
            <div class="card-body d-grid gap-2">
                <button class="btn btn-primary btn-sm" onclick="callApi('/api/authapi/profile')">
                    GET /profile
                </button>
                <button class="btn btn-danger btn-sm" onclick="callApi('/api/authapi/admin-only')">
                    GET /admin-only
                </button>
            </div>
        </div>

        <div class="card shadow-sm mb-3">
            <div class="card-header bg-warning text-dark"><strong>Step 3 — Refresh Token</strong></div>
            <div class="card-body d-grid gap-2">
                <button class="btn btn-warning btn-sm" onclick="refreshTokens()">
                    POST /api/authapi/refresh
                </button>
                <small class="text-muted">
                    Simulates: access token expired → get new one using refresh token (no re-login)
                </small>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-header bg-dark text-white"><strong>Step 4 — Logout (Revoke)</strong></div>
            <div class="card-body d-grid gap-2">
                <button class="btn btn-dark btn-sm" onclick="revokeToken()">
                    POST /api/authapi/revoke
                </button>
                <button class="btn btn-outline-secondary btn-sm" onclick="clearAll()">
                    Clear all (client only)
                </button>
                <small class="text-muted">
                    Revoke marks the refresh token as invalid in DB
                </small>
            </div>
        </div>
    </div>

    <!-- Right: tokens + response -->
    <div class="col-md-8">
        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <div class="card shadow-sm h-100">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <strong class="small">Access Token (JWT)</strong>
                        <span id="accessStatus" class="badge bg-secondary">None</span>
                    </div>
                    <div class="card-body p-2">
                        <textarea id="accessTokenBox" class="form-control form-control-sm font-monospace"
                                  rows="4" placeholder="Short-lived JWT..." readonly></textarea>
                        <div id="accessInfo" class="mt-1 small text-muted"></div>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card shadow-sm h-100">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <strong class="small">Refresh Token</strong>
                        <span id="refreshStatus" class="badge bg-secondary">None</span>
                    </div>
                    <div class="card-body p-2">
                        <textarea id="refreshTokenBox" class="form-control form-control-sm font-monospace"
                                  rows="4" placeholder="Long-lived random string..." readonly></textarea>
                        <div id="refreshInfo" class="mt-1 small text-muted"></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-header"><strong>API Response</strong></div>
            <div class="card-body p-2">
                <pre id="responseBox" class="bg-light p-3 rounded small mb-0"
                     style="min-height:120px; max-height:250px; overflow-y:auto;">Response will appear here...</pre>
            </div>
        </div>

        <div class="card border-0 shadow-sm mt-3">
            <div class="card-header bg-light"><strong>Refresh Token Flow — How it works</strong></div>
            <div class="card-body small">
                <div class="d-flex gap-2 flex-wrap">
                    <span class="badge bg-success p-2">1. Login → get AccessToken (10min) + RefreshToken (7days)</span>
                    <span class="text-muted">→</span>
                    <span class="badge bg-primary p-2">2. Use AccessToken for all API calls</span>
                    <span class="text-muted">→</span>
                    <span class="badge bg-danger p-2">3. AccessToken expires → 401</span>
                    <span class="text-muted">→</span>
                    <span class="badge bg-warning text-dark p-2">4. Send RefreshToken → get NEW AccessToken</span>
                    <span class="text-muted">→</span>
                    <span class="badge bg-dark p-2">5. Logout → revoke RefreshToken in DB</span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let accessToken = null;
    let refreshToken = null;

    async function loginJwt() {
        const email = document.getElementById('email').value;
        const password = document.getElementById('password').value;
        setResponse('Calling POST /api/authapi/login ...');

        const res = await fetch('/api/authapi/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, password, rememberMe: false })
        });
        const text = await res.text();
        const data = text ? JSON.parse(text) : {};

        if (res.ok) {
            accessToken = data.accessToken;
            refreshToken = data.refreshToken;

            document.getElementById('accessTokenBox').value = accessToken;
            document.getElementById('refreshTokenBox').value = refreshToken;

            // Decode JWT payload
            const payload = JSON.parse(atob(accessToken.split('.')[1]));
            const expTime = new Date(payload.exp * 1000).toLocaleTimeString();

            document.getElementById('accessStatus').textContent = 'Active ✅';
            document.getElementById('accessStatus').className = 'badge bg-success';
            document.getElementById('accessInfo').textContent = `Expires: ${expTime}`;

            document.getElementById('refreshStatus').textContent = 'Active ✅';
            document.getElementById('refreshStatus').className = 'badge bg-success';
            document.getElementById('refreshInfo').textContent =
                `Expires: ${new Date(data.refreshTokenExpiry).toLocaleDateString()}`;
        }
        setResponse({ httpStatus: res.status, ...data });
    }

    async function callApi(url) {
        if (!accessToken) { setResponse({ error: 'Login first to get an access token.' }); return; }
        setResponse(`Calling ${url} ...`);
        const res = await fetch(url, {
            headers: { 'Authorization': `Bearer ${accessToken}` }
        });
        const text = await res.text();
        const data = text ? JSON.parse(text) : { status: res.status };
        setResponse({ httpStatus: res.status, ...data });
    }

    async function refreshTokens() {
        if (!refreshToken) { setResponse({ error: 'Login first to get a refresh token.' }); return; }
        setResponse('Calling POST /api/authapi/refresh ...');

        const res = await fetch('/api/authapi/refresh', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ refreshToken })
        });
        const text = await res.text();
        const data = text ? JSON.parse(text) : {};

        if (res.ok) {
            // OLD tokens replaced — this is Token Rotation
            accessToken = data.accessToken;
            refreshToken = data.refreshToken;

            document.getElementById('accessTokenBox').value = accessToken;
            document.getElementById('refreshTokenBox').value = refreshToken;

            const payload = JSON.parse(atob(accessToken.split('.')[1]));
            document.getElementById('accessInfo').textContent =
                `NEW token. Expires: ${new Date(payload.exp * 1000).toLocaleTimeString()}`;
            document.getElementById('refreshInfo').textContent =
                `NEW token. Expires: ${new Date(data.refreshTokenExpiry).toLocaleDateString()}`;
        } else {
            document.getElementById('accessStatus').textContent = 'Expired ❌';
            document.getElementById('accessStatus').className = 'badge bg-danger';
        }
        setResponse({ httpStatus: res.status, ...data });
    }

    async function revokeToken() {
        if (!refreshToken) { setResponse({ error: 'No refresh token to revoke.' }); return; }
        setResponse('Calling POST /api/authapi/revoke ...');

        const res = await fetch('/api/authapi/revoke', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${accessToken}`
            },
            body: JSON.stringify({ refreshToken })
        });
        const text = await res.text();
        const data = text ? JSON.parse(text) : {};

        if (res.ok) clearAll();
        setResponse({ httpStatus: res.status, ...data });
    }

    function clearAll() {
        accessToken = null; refreshToken = null;
        document.getElementById('accessTokenBox').value = '';
        document.getElementById('refreshTokenBox').value = '';
        document.getElementById('accessStatus').textContent = 'None';
        document.getElementById('accessStatus').className = 'badge bg-secondary';
        document.getElementById('refreshStatus').textContent = 'None';
        document.getElementById('refreshStatus').className = 'badge bg-secondary';
        document.getElementById('accessInfo').textContent = '';
        document.getElementById('refreshInfo').textContent = '';
    }

    function setResponse(data) {
        document.getElementById('responseBox').textContent =
            typeof data === 'string' ? data : JSON.stringify(data, null, 2);
    }
</script>
}
